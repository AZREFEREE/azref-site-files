// backend/events.jsw
// Event registration for Education Events rows whose Registration field is "On this site (ROC)".
//
// 10/3/26: the ROC is the home for event registrations (admin.azref.com, Front Office -> Events).
// Each sign-up goes to the ROC FIRST (asra-api k-events-register, server to server, header X-ASRA-Key =
// Wix secret ASRA_EVENTS_KEY). The ROC issues the reference number and status; the confirmation email and
// the admin@ notice use them. The CMS collection "EventRegistrations" stays as the backup copy (ONE row per
// email per event; a second submit with the same email updates that row and the ROC row).
// If the ROC can't be reached (or doesn't know the event), the sign-up is still saved here with a Wix-made
// reference, inRoc = false, and the admin@ notice says it needs adding to the ROC.
//
// Collection "EventRegistrations" permissions: Read / Create / Update / Delete = Admin only (writes use suppressAuth).
import wixData from 'wix-data';
import { ensureCollection } from 'backend/kb-collections';
import { sendEmail, sendAdmin } from 'backend/kb-mail';
import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';

const ROC_REGISTER = 'https://knuchrlsmebojlzytrcs.functions.supabase.co/asra-api/k-events-register?event=';
const ROC_EVENTS = 'https://admin.azref.com/#/events/';

/**
 * Send one registration to the ROC. Returns the ROC's answer ({ ok, ref, updated, status } or
 * { ok:false, error, fields? }) or null when it couldn't be reached. Never throws.
 */
async function toRoc(eventKey, payload) {
  try {
    const key = await getSecret('ASRA_EVENTS_KEY');
    if (!key) { console.error('events -> ROC: secret ASRA_EVENTS_KEY is missing'); return null; }
    const res = await Promise.race([
      fetch(ROC_REGISTER + encodeURIComponent(eventKey), { method: 'post',
        headers: { 'Content-Type': 'application/json', 'X-ASRA-Key': key }, body: JSON.stringify(payload) }),
      new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 8000))
    ]);
    let j = null; try { j = await res.json(); } catch (e) { j = null; }
    if (!j || !j.ok) console.error('events -> ROC refused (' + res.status + '): ' + JSON.stringify(j));
    return j;
  } catch (e) {
    console.error('events -> ROC failed: ' + (e && (e.message || e)));
    return null;
  }
}
function isoTime(v) { const d = v instanceof Date ? v : new Date(v); return isNaN(d.getTime()) ? '' : d.toISOString(); }

const EVENTS = 'Import12';            // Education Events
const COLLECTION = 'EventRegistrations';
const OPTS = { suppressAuth: true };
const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
const EXPERIENCE = ['Less than 1 year', '1 to 2 years', '2 to 4 years', '5 years or more'];
const FITS = ["Men's", "Women's"];
const SIZES = ['XS', 'S', 'M', 'L', 'XL', 'XXL', '3XL'];

function s(v, max) { return String(v === undefined || v === null ? '' : v).trim().slice(0, max || 200); }
function pad(n, w) { return String(n).padStart(w, '0'); }
function azTodayISO() { return new Date(Date.now() - 7 * 3600 * 1000).toISOString().slice(0, 10); }
function toISO(v) {
  if (!v) return '';
  if (v instanceof Date) return isNaN(v.getTime()) ? '' : v.toISOString().slice(0, 10); // stored at UTC midnight
  const t = String(v).trim();
  let m = t.match(/^(\d{4})-(\d{2})-(\d{2})/); if (m) return m[0];
  m = t.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
  return m ? `${m[3]}-${m[1].padStart(2, '0')}-${m[2].padStart(2, '0')}` : '';
}
/** "Lunch (11:30 AM)\nTraining and instruction (12:00 to 4:30 PM)" -> [{id:'lunch', label:'Lunch', time:'11:30 AM'}, ...] */
function parseSessions(text) {
  return String(text || '').split('\n').map(x => x.trim()).filter(Boolean).map(line => {
    const m = line.match(/^(.*?)\s*\((.*)\)\s*$/);
    const label = m ? m[1] : line, time = m ? m[2] : '';
    return { id: label.split(' ')[0].toLowerCase().replace(/[^a-z0-9]/g, ''), label, time };
  });
}
function askList(text) { return String(text || '').split(',').map(x => x.trim().toLowerCase()).filter(Boolean); }
function slugify(t) { return String(t || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); }
/** Event id from the Link column: "register.html?e=academy-2026" or "/register/academy-2026". */
function linkId(link) { const m = String(link || '').match(/[?&]e=([^&#]+)|\/register\/([^\/?#]+)/); return m ? decodeURIComponent(m[1] || m[2]) : ''; }
/** Same rule as the kb-register element (src/cms-map.js): Slug field, else the id in Link, else the title. */
function eventKey(ev) { return ev.slug || linkId(ev.link) || slugify(ev.title) || ev._id; }
/** Find the Education Events row: by item _id first, else by the page's event id (slug / link id / title). */
async function findEvent(eventItemId, eventId) {
  if (eventItemId) {
    try { const ev = await wixData.get(EVENTS, eventItemId, OPTS); if (ev) return ev; } catch (e) { /* fall through */ }
  }
  if (!eventId) return null;
  const all = await wixData.query(EVENTS).limit(1000).find(OPTS);
  return all.items.find(ev => eventKey(ev) === eventId) || null;
}

const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
/** "2026-10-18" -> "Sunday, October 18, 2026" */
function longDate(iso) {
  const m = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return '';
  const d = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));
  return `${DAYS[d.getUTCDay()]}, ${MONTHS[d.getUTCMonth()]} ${d.getUTCDate()}, ${m[1]}`;
}
/** Confirmation to the registrant + notification to admin@azref.com. Failures are logged only (backend/kb-mail.js). */
async function mailRegistration(ev, rec, ref, status, updated, inRoc) {
  const when = [longDate(rec.eventDate), s(ev.timeText, 80), s(ev.venue, 120), s(ev.address, 200)].filter(Boolean).join('\n');
  const statusText = status === 'Waitlist' ? 'Waitlist (we\u2019ll contact you if a spot opens up)' : status;
  const details = [['Experience', rec.experience], ['Shirt', [rec.shirtFit, rec.shirtSize].filter(Boolean).join(' ')],
    ['Dietary needs', rec.dietary], ['Change', updated ? 'Updated an earlier registration' : '']]
    .filter(x => x[1]).map(x => x[0] + ': ' + x[1]).join('\n');
  const res = await Promise.all([
    sendEmail('regConfirm', { email: rec.email, first: rec.firstName, last: rec.lastName },
      { ref, name: rec.firstName, event: ev.title, when, status: statusText, sessions: rec.sessionLabels }),
    sendAdmin('regAdmin', { ref, name: `${rec.firstName} ${rec.lastName}`, email: rec.email, phone: rec.phone, ussf: rec.ussfId,
      event: ev.title, when, status: updated ? `${status} (updated)` : status, sessions: rec.sessionLabels, details,
      eventId: rec.eventId,
      where: inRoc ? 'It\u2019s in the ROC under Front Office \u2192 Events.'
        : 'Heads up: this one did NOT reach the ROC automatically, so it\u2019s only in the Wix CMS for now. Add it in the ROC with + Add Someone (same reference number).' })
  ]);
  return res[0];
}

/**
 * registerForEvent(eventItemId, data, eventId) -> { ok, ref, updated, status } | { ok:false, error, fields? }
 * eventItemId = the Education Events item _id (the kb-register element sends it in the kb-submit event);
 * eventId     = the page's event id (e.g. academy-2026), used when the _id is missing.
 * data: { firstName, lastName, email, phone, ussfId, sessions: [ids], experience, shirtFit, shirtSize, dietary, website }
 */
export async function registerForEvent(eventItemId, data, eventId) {
  await ensureCollection(COLLECTION);
  data = data || {};
  if (s(data.website)) return { ok: true, ref: 'E-0000', updated: false, status: 'Registered' }; // honeypot

  const ev = await findEvent(eventItemId, eventId);
  if (!ev) return { ok: false, error: 'notfound' };
  if (!/on this site/i.test(String(ev.registration || ''))) return { ok: false, error: 'closed' };
  const today = azTodayISO(), date = toISO(ev.date), closes = toISO(ev.registrationCloses);
  if ((date && date < today) || (closes && closes < today)) return { ok: false, error: 'closed' };

  const sessions = parseSessions(ev.sessions), ask = askList(ev.askFor);
  const r = {
    firstName: s(data.firstName, 80), lastName: s(data.lastName, 80), email: s(data.email).toLowerCase(),
    phone: s(data.phone, 40), ussfId: s(data.ussfId, 30),
    sessions: (Array.isArray(data.sessions) ? data.sessions : []).map(x => s(x, 40)).filter(id => sessions.some(z => z.id === id)),
    experience: ask.indexOf('experience') > -1 ? s(data.experience, 40) : '',
    shirtFit: ask.indexOf('shirt') > -1 ? s(data.shirtFit, 20) : '',
    shirtSize: ask.indexOf('shirt') > -1 ? s(data.shirtSize, 10) : '',
    dietary: ask.indexOf('dietary') > -1 ? s(data.dietary, 300) : ''
  };
  const bad = ['firstName', 'lastName', 'email', 'phone'].filter(k => !r[k]);
  if (r.email && !EMAIL_RE.test(r.email)) bad.push('email');
  if (sessions.length && !r.sessions.length) bad.push('sessions');
  if (ask.indexOf('experience') > -1 && EXPERIENCE.indexOf(r.experience) < 0) bad.push('experience');
  if (ask.indexOf('shirt') > -1 && (FITS.indexOf(r.shirtFit) < 0 || SIZES.indexOf(r.shirtSize) < 0)) bad.push('shirtSize');
  if (bad.length) return { ok: false, error: 'invalid', fields: bad.filter((k, i, a) => a.indexOf(k) === i) };

  const key = eventKey(ev);
  const record = Object.assign({}, r, {
    title: `${r.firstName} ${r.lastName}`,
    eventId: key, eventTitle: ev.title, eventDate: date,
    sessions: r.sessions.join(', '),
    sessionLabels: sessions.filter(z => r.sessions.indexOf(z.id) > -1).map(z => z.label).join(', '),
    source: 'Web'
  });

  const existing = await wixData.query(COLLECTION).eq('eventId', key).eq('email', r.email).limit(1).find(OPTS);
  const old = existing.items.length ? existing.items[0] : null;

  // 1) The ROC first: it decides the reference number and status (and keeps one row per email).
  const payload = { source: 'Web', firstName: r.firstName, lastName: r.lastName, email: r.email, phone: r.phone,
    ussfId: r.ussfId, sessions: r.sessions, experience: r.experience, shirtFit: r.shirtFit, shirtSize: r.shirtSize, dietary: r.dietary };
  if (old && old.ref) { payload.ref = old.ref; payload.registeredAt = isoTime(old.registeredAt); } // heals one that never reached the ROC
  const roc = await toRoc(key, payload);
  if (roc && !roc.ok && roc.error === 'closed') return { ok: false, error: 'closed' };
  if (roc && !roc.ok && roc.error === 'invalid') return { ok: false, error: 'invalid', fields: roc.fields || [] };
  const inRoc = !!(roc && roc.ok && roc.ref);

  if (old) {
    // Keep ref, status and original sign-up time (= place in line); overwrite the answers.
    const ref = inRoc ? roc.ref : old.ref;
    const status = inRoc ? roc.status : (old.status === 'Cancelled' ? 'Registered' : old.status);
    const upd = Object.assign({}, old, record, { _id: old._id, ref, status, inRoc: inRoc || !!old.inRoc, registeredAt: old.registeredAt, updatedAt: new Date() });
    await wixData.update(COLLECTION, upd, OPTS);
    const emailed = await mailRegistration(ev, upd, ref, status, true, inRoc);
    return { ok: true, ref, updated: true, status, emailed };
  }

  let ref = inRoc ? roc.ref : '', status = inRoc ? roc.status : 'Registered';
  if (!inRoc) {
    // Fallback only (ROC unreachable): ref E-<4 letters of event id><YY>-NNNN, e.g. E-ACAD26-0039
    const letters = String(key).replace(/[^a-z]/gi, '').slice(0, 4).toUpperCase() || 'EVNT';
    const yy = (date || today).slice(2, 4);
    const count = await wixData.query(COLLECTION).eq('eventId', key).count(OPTS);
    let n = count + 1;
    for (let tries = 0; tries < 50; tries++, n++) {
      const tryRef = `E-${letters}${yy}-${pad(n, 4)}`;
      if (!(await wixData.query(COLLECTION).eq('ref', tryRef).count(OPTS))) { ref = tryRef; break; }
    }
    if (!ref) ref = `E-${letters}${yy}-${pad(1000 + Math.floor(Math.random() * 9000), 4)}`;
    // Capacity (optional): when full, new sign-ups go on the waitlist.
    const cap = parseInt(ev.capacity, 10);
    if (cap > 0) {
      const taken = await wixData.query(COLLECTION).eq('eventId', key).eq('status', 'Registered').count(OPTS);
      if (taken >= cap) status = 'Waitlist';
    }
  }
  await wixData.insert(COLLECTION, Object.assign(record, { ref, status, inRoc, registeredAt: new Date(), updatedAt: new Date() }), OPTS);
  const emailed = await mailRegistration(ev, record, ref, status, false, inRoc);
  return { ok: true, ref, updated: false, status, emailed };
}
